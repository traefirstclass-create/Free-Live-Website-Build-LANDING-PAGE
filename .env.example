# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for SEO/Open Graph and links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend → API Keys. FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL="Live Builds <applications@yourdomain.com>"
# Where new-application emails go (comma-separate for several)
NOTIFY_EMAIL=you@example.com

# /admin login. Use a long random password (16+ chars).
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Optional: random string used to sign the admin cookie (openssl rand -hex 32)
ADMIN_SESSION_SECRET=
