# Copy to .env.local for local dev. On Vercel, connecting the Neon database and
# Blob store adds DATABASE_URL and BLOB_READ_WRITE_TOKEN for you; add the rest
# in Vercel → Project → Settings → Environment Variables.
# Tip: with the Vercel CLI, `vercel env pull .env.local` downloads them all.

# Public site URL (used for SEO/Open Graph and links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (Vercel → Storage → Create → Neon). Stores the applications.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob (Vercel → Storage → Create → Blob, access: Private). Stores the images.
# If your project only shows BLOB_STORE_ID, open the store → ".env.local" tab and copy the token.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Resend → API Keys. FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL="Live Builds <applications@yourdomain.com>"
# Where new-application emails go (comma-separate for several)
NOTIFY_EMAIL=you@example.com

# /admin login. Use a long random password (16+ chars).
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Optional: random string used to sign the admin cookie (openssl rand -hex 32)
ADMIN_SESSION_SECRET=
